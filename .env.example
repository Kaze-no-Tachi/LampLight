# Copy to .env and adjust. Values below match the docker compose stack, so a
# straight copy works for local development.
#
# Variables are grouped by the phase that starts consuming them. Anything
# outside the "required now" block may be left blank until that phase lands.

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (required now)
# ---------------------------------------------------------------------------
# The application role. Row-level security applies to it. It must NOT hold
# BYPASSRLS or superuser, or the database isolation layer does nothing.
DATABASE_URL=postgres://lectern_app:lectern_app_password@localhost:5432/lectern

# The migration and superadmin role. Bypasses row-level security. Used by
# src/db/migrate.ts, the seed script, and superadmin routes only.
DATABASE_ADMIN_URL=postgres://lectern_admin:lectern_admin_password@localhost:5432/lectern

DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Tenancy (phase 2)
# ---------------------------------------------------------------------------
# platform: resolve the tenant from the Host header.
# single:   pin one tenant and skip lookup entirely (self-host).
TENANCY_MODE=platform
PLATFORM_APEX_DOMAIN=lectern.app
TENANT_SUBDOMAIN_ROOT=lectern.app
# Required only when TENANCY_MODE=single.
SINGLE_TENANT_SLUG=

# ---------------------------------------------------------------------------
# Auth (phase 2)
# ---------------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Custom domains, Cloudflare for SaaS (phase 3)
# ---------------------------------------------------------------------------
# Not used in single-tenant self-host mode.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=

# ---------------------------------------------------------------------------
# Object storage (phase 4)
# ---------------------------------------------------------------------------
# Minio locally, Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lectern-media
S3_ACCESS_KEY_ID=lectern_minio
S3_SECRET_ACCESS_KEY=lectern_minio_password
# Minio needs path-style addressing. R2 does not.
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Payments (phase 6)
# ---------------------------------------------------------------------------
# connect: platform mode, charges on the tenant's connected account with an
#          application fee.
# direct:  self-host mode, charges on your own account with no application fee.
PAYMENTS_MODE=connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
