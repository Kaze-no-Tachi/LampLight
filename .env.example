# Copy to .env and adjust. Values below match the docker compose stack, so a
# straight copy works for local development.
#
# Variables are grouped by the phase that starts consuming them. Anything
# outside the "required now" block may be left blank until that phase lands.

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (required now)
# ---------------------------------------------------------------------------
# The application role. Row-level security applies to it. It must NOT hold
# BYPASSRLS or superuser, or the database isolation layer does nothing.
DATABASE_URL=postgres://lamplight_app:lamplight_app_password@localhost:5432/lamplight

# The migration and superadmin role. Bypasses row-level security. Used by
# src/db/migrate.ts, the seed script, and superadmin routes only.
DATABASE_ADMIN_URL=postgres://lamplight_admin:lamplight_admin_password@localhost:5432/lamplight

DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Tenancy (phase 2)
# ---------------------------------------------------------------------------
# platform: resolve the tenant from the Host header.
# single:   pin one tenant and skip lookup entirely (self-host).
TENANCY_MODE=platform
PLATFORM_APEX_DOMAIN=lamplight.school
TENANT_SUBDOMAIN_ROOT=lamplight.school
# Required only when TENANCY_MODE=single.
SINGLE_TENANT_SLUG=

# ---------------------------------------------------------------------------
# Auth (phase 2)
# ---------------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The platform kill switch for self-serve signup. It does not open signup
# anywhere on its own: tenant_settings.signup_mode is the institute's own
# decision and defaults to closed, and both have to agree. This exists so an
# operator can stop every institute at once without editing anybody's settings.
# See docs/adr/0006.
SELF_SERVE_SIGNUP=true

# ---------------------------------------------------------------------------
# Mail (phase 2)
# ---------------------------------------------------------------------------
# Not optional in production, in either mode. Account creation ends at a link
# sent to the address, so an instance with no transport issues invitations
# nobody can act on. The app refuses to start in production without SMTP_HOST
# and MAIL_FROM.
#
# auto:    SMTP when SMTP_HOST is set, an in-memory outbox under NODE_ENV=test,
#          otherwise log the message to stderr. Leave it here for development:
#          the activation link is printed and the flow works with no mail
#          server at all.
# smtp | console | memory: force one, mostly for tests.
MAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true only for implicit TLS on port 465. STARTTLS on 587 stays false.
SMTP_SECURE=false
# The envelope sender. One platform address, not per institute: the platform's
# domain is what passes SPF and DKIM.
MAIL_FROM=

# ---------------------------------------------------------------------------
# Custom domains, Cloudflare for SaaS (phase 3)
# ---------------------------------------------------------------------------
# Not used in single-tenant self-host mode.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=

# Shared secret for the maintenance sweep, which cron POSTs to
# /api/platform/sweep. Unset means that endpoint 404s, which is also what a
# wrong secret gets, so whether an instance runs the sweep is not discoverable
# from outside. Generate with: openssl rand -base64 32
#
# Worth setting even on a self-hosted single-tenant box: the sweep also deletes
# expired signup invitations, which hold the name and address of people who
# never completed signup. See docs/runbook.md section 4c.
DOMAIN_SWEEP_SECRET=

# ---------------------------------------------------------------------------
# Object storage (phase 4)
# ---------------------------------------------------------------------------
# Minio locally, Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lamplight-media
S3_ACCESS_KEY_ID=lamplight_minio
S3_SECRET_ACCESS_KEY=lamplight_minio_password
# Minio needs path-style addressing. R2 does not.
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Payments (phase 6)
# ---------------------------------------------------------------------------
# connect: platform mode, charges on the tenant's connected account with an
#          application fee.
# direct:  self-host mode, charges on your own account with no application fee.
PAYMENTS_MODE=connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Nothing below is read by the application. These feed the compose files, and
# in production they live in the Dokploy environment store rather than in any
# file in this repository. See docs/runbook.md.

# --- Platform, docker-compose.prod.yml -------------------------------------
# Inside the compose network the database is reached by service name, so the
# production DATABASE_URL host is "postgres", not "localhost".
#   DATABASE_URL=postgres://lamplight_app:<app-password>@postgres:5432/lamplight
#   DATABASE_ADMIN_URL=postgres://lamplight_admin:<admin-password>@postgres:5432/lamplight
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=

# Published by CI to GitHub Container Registry.
LAMPLIGHT_IMAGE=
LAMPLIGHT_MIGRATOR_IMAGE=

# Directory on the VPS holding the tunnel credentials JSON produced by
# `cloudflared tunnel create`. Mode 600, never committed.
CLOUDFLARED_CREDENTIALS_DIR=/srv/lamplight/cloudflared

# --- Self-host, docker-compose.selfhost.yml --------------------------------
# The single domain you point at this box. Caddy gets a certificate for it.
SELFHOST_DOMAIN=
ACME_EMAIL=
MINIO_ROOT_USER=lamplight_minio
MINIO_ROOT_PASSWORD=
